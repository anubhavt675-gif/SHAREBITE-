# ==============================================================================
# ShareBite Web Environment Variables (.env.example)
# Copy this file to .env.local for local development and set identical keys
# in Vercel Project Settings -> Environment Variables.
#
# SECURITY: NEVER put SUPABASE_SERVICE_ROLE_KEY or GOOGLE_MAPS_SERVER_API_KEY
# in a VITE_ variable — anything prefixed with VITE_ is bundled into browser JS.
# ==============================================================================

# Supabase Project URL (e.g., https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anon / Publishable Key
VITE_SUPABASE_ANON_KEY=

# Optional: Restricted Browser Google Maps JavaScript / Embed API Key
# Restrict by HTTP referrer (e.g. https://sharebite-final.vercel.app/*) in Google Cloud Console.
# When unset, ShareBite falls back cleanly to embedded OpenStreetMap inside the app.
VITE_GOOGLE_MAPS_API_KEY=

# Server-Side Only (Vercel Environment Variable — NEVER prefix with VITE_):
# Google Cloud API Key with "Places API (New)" enabled, restricted by API to Places API (New).
# Powers /api/ngo-search and /api/ngo-details for India-wide NGO discovery.
GOOGLE_MAPS_SERVER_API_KEY=
