# ==============================================================================
# ShareBite Web Environment Variables (.env.example)
# Copy this file to .env.local for local development and set identical keys
# in Vercel Project Settings -> Environment Variables.
#
# SECURITY: NEVER put SUPABASE_SERVICE_ROLE_KEY or any private secret in a
# VITE_ variable — anything prefixed with VITE_ is bundled into browser JS.
# ==============================================================================

# Supabase Project URL (e.g., https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=

# Supabase Public Anon / Publishable Key
VITE_SUPABASE_ANON_KEY=

# Optional: Restricted Browser Google Maps JavaScript API Key
# Restrict by HTTP referrer (e.g. https://sharebite-final.vercel.app/*) in Google Cloud Console.
# When unset, ShareBite falls back cleanly to embedded OpenStreetMap + OSRM road routing inside the app.
VITE_GOOGLE_MAPS_API_KEY=
